---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import PhoneMockup from '~/components/ui/PhoneMockup.astro';
import Content from '~/components/widgets/Content.astro';
import Features from '~/components/widgets/Features.astro';
import Features2 from '~/components/widgets/Features2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import StructuredData from '~/components/common/StructuredData.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import Headline from '~/components/ui/Headline.astro';
import Image from '~/components/common/Image.astro';

import demoMessagingThumb from '~/assets/images/demo-messaging-thumbnail.png';
import demoAdminThumb from '~/assets/images/demo-admin-thumbnail.png';

const metadata = {
  title: 'Product',
  description: 'Explore HippoChat capabilities: cross-organization messaging, audit trails, configurable retention, fast onboarding, and BAA availability.',
};
---

<Layout metadata={metadata}>
  <StructuredData
    type="product"
    breadcrumbs={[
      { name: 'Home', url: '/' },
      { name: 'Product', url: '/product' },
    ]}
  />
  <!-- Hero -->
  <Hero
    tagline="Product"
    actions={[
      {
        variant: 'primary',
        text: 'Request a Demo',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title">
      Messaging Built for <span class="text-accent dark:text-white">Cross-Organizational Care</span>
    </Fragment>

    <Fragment slot="subtitle">
      Healthcare teams span multiple organizations. HippoChat is secure messaging designed for exactly that.
    </Fragment>

    <Fragment slot="image">
      <PhoneMockup />
    </Fragment>
  </Hero>

  <!-- What HippoChat Is -->
  <Content
    tagline='What <span class="text-accent dark:text-white">HippoChat</span> Is'
    title="Purpose-Built for Cross-Organization Communication"
    image={{
      src: '~/assets/images/why-hippochat.png',
      alt: 'HippoChat secure platform diagram',
      width: 768,
      height: 512,
    }}
  >
    <Fragment slot="content">
      <p class="mb-4">
        <span class="text-accent dark:text-white">HippoChat</span> exists for the reality that clinical teams coordinate care across different systems. Not everyone is on the same EHR or messaging platform—and they don't need to be. HippoChat connects them securely.
      </p>
      <ul class="list-disc list-inside space-y-2">
        <li>Purpose-built for healthcare — <a href="/use-cases" class="text-accent hover:underline">see use cases</a></li>
        <li>Respects organizational boundaries</li>
        <li><a href="/security" class="text-accent hover:underline">Secure and auditable</a></li>
      </ul>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-slate-50 dark:bg-slate-900/30"></div>
    </Fragment>
  </Content>

  <!-- Core Capabilities -->
  <Features
    tagline="Capabilities"
    title="Core Capabilities"
    columns={3}
    items={[
      {
        title: 'Separate users, shared communication',
        description: 'Each organization keeps its own users and boundaries—you collaborate across them.',
        icon: 'tabler:building',
      },
      {
        title: 'Know who said what, when',
        description: 'Every message is logged so you always know who sent it, when, and who saw it.',
        icon: 'tabler:shield-check',
      },
      {
        title: 'Permissions that fit your workflow',
        description: 'Control who can see and do what, matched to how your team actually works.',
        icon: 'tabler:lock',
      },
      {
        title: 'Keep records on your terms',
        description: 'Keep messages as long or as short as your compliance requirements need.',
        icon: 'tabler:clock',
      },
      {
        title: 'Onboard partners in minutes',
        description: 'Send a link—they open it in any browser and start messaging. No app download, no install, no IT involvement.',
        icon: 'tabler:user-plus',
      },
      {
        title: 'No app required',
        description: 'Entirely browser-based—mobile browser on phones, web browser on desktop. Nothing to download or deploy.',
        icon: 'tabler:browser',
      },
      {
        title: 'Cloud-hosted and ready to go',
        description: 'Fully managed platform—each organization\'s data stays securely separated.',
        icon: 'tabler:cloud',
      },
    ]}
  />

  <!-- What HippoChat Replaces -->
  <Features2
    tagline="Replaces"
    title='What <span class="text-accent dark:text-white">HippoChat</span> Replaces'
    columns={2}
    classes={{
      container: '[&>div:last-child]:sm:col-span-2 [&>div:last-child]:sm:mx-auto [&>div:last-child]:sm:w-[calc(50%-1.5rem)]',
    }}
    items={[
      {
        title: 'SMS and personal phones',
        description: 'Move PHI off personal devices and into a secure, compliant channel.',
        icon: 'tabler:device-mobile-off',
      },
      {
        title: 'Pager systems',
        description: 'Real messaging with audit trails, not codes and callbacks.',
        icon: 'tabler:bell-off',
      },
      {
        title: 'Secure texting tools (single-org)',
        description: 'Built for multiple organizations with clear boundaries.',
        icon: 'tabler:message-off',
      },
      {
        title: 'Native app-based secure texting',
        description: 'No app store downloads, no IT-managed device deployments. HippoChat runs in the browser everyone already has.',
        icon: 'tabler:app-window',
      },
      {
        title: '"Temporary" access to internal systems',
        description: 'Stop managing extra EHR logins for outside partners that never get cleaned up.',
        icon: 'tabler:key-off',
      },
    ]}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50/50 dark:bg-blue-950/20"></div>
    </Fragment>
  </Features2>

  <!-- Video Demos -->
  <WidgetWrapper id="demos">
    <Headline
      tagline="Demos"
      title='See <span class="text-accent dark:text-white">HippoChat</span> in Action'
      subtitle="Walk through the messaging experience your clinical teams use every day, and the admin console your IT and compliance teams use to manage it."
    />
    <div class="grid gap-8 lg:grid-cols-2">
      <div>
        <div class="yt-lite-wrapper relative overflow-hidden rounded-lg shadow-lg ring-1 ring-slate-200 dark:ring-slate-700" style="aspect-ratio: 16 / 9;">
          <button
            type="button"
            class="yt-lite group absolute inset-0 block h-full w-full cursor-pointer overflow-hidden border-0 bg-transparent p-0"
            data-yt-id="n3-fCfBq_rY"
            data-yt-title="HippoChat messaging demo"
            aria-label="Play HippoChat messaging demo"
          >
            <Image
              src={demoMessagingThumb}
              alt="HippoChat messaging demo thumbnail"
              width={1280}
              height={720}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 600px, 100vw"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
              loading="lazy"
            />
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-white opacity-25 shadow-[0_6px_20px_rgba(0,0,0,0.35)] ring-4 ring-white transition-all duration-200 group-hover:scale-110 group-hover:bg-secondary group-hover:opacity-100">
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 translate-x-0.5" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
              </span>
            </span>
          </button>
        </div>
        <h3 class="mt-4 text-lg font-bold text-heading">Messaging Demo</h3>
        <p class="mt-1 text-muted">How clinicians and external partners send secure messages in any browser—no app required—so PHI moves through an audited, compliant channel instead of risky SMS or personal phones.</p>
      </div>
      <div>
        <div class="yt-lite-wrapper relative overflow-hidden rounded-lg shadow-lg ring-1 ring-slate-200 dark:ring-slate-700" style="aspect-ratio: 16 / 9;">
          <button
            type="button"
            class="yt-lite group absolute inset-0 block h-full w-full cursor-pointer overflow-hidden border-0 bg-transparent p-0"
            data-yt-id="WQxpJdHVXog"
            data-yt-title="HippoChat admin demo"
            aria-label="Play HippoChat admin demo"
          >
            <Image
              src={demoAdminThumb}
              alt="HippoChat admin demo thumbnail"
              width={1280}
              height={720}
              widths={[640, 960, 1280]}
              sizes="(min-width: 1024px) 600px, 100vw"
              class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
              loading="lazy"
            />
            <span class="absolute inset-0 flex items-center justify-center">
              <span class="flex h-14 w-14 items-center justify-center rounded-full bg-primary text-white opacity-25 shadow-[0_6px_20px_rgba(0,0,0,0.35)] ring-4 ring-white transition-all duration-200 group-hover:scale-110 group-hover:bg-secondary group-hover:opacity-100">
                <svg viewBox="0 0 24 24" fill="currentColor" class="h-6 w-6 translate-x-0.5" aria-hidden="true"><path d="M8 5v14l11-7z"></path></svg>
              </span>
            </span>
          </button>
        </div>
        <h3 class="mt-4 text-lg font-bold text-heading">Admin Demo</h3>
        <p class="mt-1 text-muted">How admins manage users, permissions, retention, and audit trails across organizations—and keep an eye on message queues so critical communications don't get lost.</p>
      </div>
    </div>
  </WidgetWrapper>

  <script>
    document.querySelectorAll<HTMLButtonElement>('button.yt-lite').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.ytId;
        if (!id) return;
        const title = btn.dataset.ytTitle ?? 'YouTube video';
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0`;
        iframe.title = title;
        iframe.setAttribute(
          'allow',
          'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share'
        );
        iframe.setAttribute('allowfullscreen', '');
        iframe.setAttribute('referrerpolicy', 'strict-origin-when-cross-origin');
        iframe.className = 'absolute inset-0 h-full w-full border-0';
        btn.replaceWith(iframe);
      });
    });
  </script>

  <!-- CTA -->
  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: 'Request a Demo',
        href: '/contact',
      },
    ]}
  >
    <Fragment slot="title">Ready to See It Live?</Fragment>
    <Fragment slot="subtitle">
      Learn how <span class="text-accent dark:text-white">HippoChat</span> can solve your cross-organizational communication challenges.
    </Fragment>
  </CallToAction>
</Layout>
